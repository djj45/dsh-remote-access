* text=auto

# Server-side and cross-platform text files always keep LF.
*.sh   text eol=lf
*.toml text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.plist text eol=lf
*.md   text eol=lf
*.conf text eol=lf
*.service text eol=lf

# Windows-native scripts keep CRLF.
*.cmd text eol=crlf
*.ps1 text eol=crlf
